{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "lib": ["ES2023", "DOM"],
    "types": ["node"]
  },
  "include": ["apps/api/src", "apps/api/test", "packages/core/src", "packages/core/test", "packages/connectors/*/src", "packages/connectors/*/test", "packages/connectors/*/scripts"]
}
