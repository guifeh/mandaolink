# ==============================================================================
# MandaoLink - Variáveis de Ambiente (.env.example)
# ==============================================================================
# Copie este arquivo para .env na raiz do projeto:
#   Copy-Item .env.example .env (PowerShell) ou cp .env.example .env (Bash)
# ATENÇÃO: Nunca versionar o arquivo .env real no Git!
# ==============================================================================

# --- BANCO DE DADOS (Postgres 16) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=defina_uma_senha_forte_aqui_obrigatoria
POSTGRES_DB=mandaolink
POSTGRES_PORT=5432

# URL de conexão do Postgres:
# Para desenvolvimento local fora do Docker:
DATABASE_URL=postgresql://postgres:defina_uma_senha_forte_aqui_obrigatoria@localhost:5432/mandaolink?sslmode=disable
# Nota: Quando executado dentro do container 'app', o compose usa o host interno 'postgres'.

# --- APLICAÇÃO API (Fastify) ---
NODE_ENV=development
HOST=127.0.0.1
PORT=3000

# Origem da aplicação (CORS e validação de sessão):
# Desenvolvimento local: http://localhost:3000
# Produção com Cloudflare Tunnel: https://painel.seudominio.com.br
APP_ORIGIN=http://localhost:3000
COOKIE_SECURE=false

# --- AUTENTICAÇÃO DO CLIENTE / ADMINISTRADOR ---
# E-mail que receberá os links mágicos de autenticação (obrigatório)
OWNER_EMAIL=guilherme@example.com

# --- MODO DE CONECTORES E SIMULAÇÃO (Task P5) ---
# CONNECTORS: fake (padrão seguro) ou real.
# Em fake, simula leitura e envio sem conectar serviços reais.
CONNECTORS=fake
# DRY_RUN: true (padrão seguro) ou false.
# Em real com DRY_RUN=true, não transmite externamente.
DRY_RUN=true

# --- CLOUDFLARE TUNNEL (Opcional - Task J5) ---
# Token fornecido pelo painel do Cloudflare Zero Trust (túnel mandaolink).
# Deixe vazio para rodar localmente sem túnel.
# Ao preencher, execute: docker compose --profile tunnel up -d
TUNNEL_TOKEN=

# --- SEGURANÇA E PROXIES DO TÚNEL CLOUDFLARE ---
# Lista de IPs ou CIDRs exatos de proxies confiáveis (peer do cloudflared na rede interna mandaolink-edge).
# Vazio = nenhum proxy confiável (ignora headers CF-Connecting-IP/X-Forwarded-For para evitar spoofing).
# Ao rodar com túnel via docker compose (--profile tunnel), defina com o CIDR da rede edge: 172.31.250.0/29
# NUNCA use trustProxy=true nem ranges públicos amplos da Cloudflare aqui, pois o peer direto é o container.
TRUSTED_TUNNEL_PROXIES=

# --- MONITORAMENTO EXTERNO (Heartbeat / Dead Man's Snitch) ---
# URL de ping periódico (ex: Better Uptime, Healthchecks.io).
# Vazio = monitoramento desativado.
# Quando preenchido, envia ping a cada 5 minutos somente se o banco de dados estiver saudável.
HEARTBEAT_URL=

# --- NOTA SOBRE TAG DE AFILIADO AMAZON E NICHOS ---
# A tag Amazon (tag_amazon) e as configurações de nicho NÃO são lidas via variáveis
# de ambiente. Elas são persistidas na tabela config_nicho e configuradas dinamicamente
# pelo cliente via painel/API (PUT /config).

# --- CONECTORES (S2 WhatsApp / S3 Telegram) ---
# Chaves de cifragem do auth state em disco: 32 bytes em base64. Gere com:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Perder a chave = parear/entrar de novo. Guarde fora do PC (cofre).
WA_AUTH_KEY=
TG_SESSION_KEY=
# Bot API: token do BotFather, para fontes que adicionarem o bot (só leitura).
TG_BOT_TOKEN=
# MTProto (conta de leitura de canais públicos): my.telegram.org > API development tools.
TG_API_ID=
TG_API_HASH=
